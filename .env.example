# Jarvis reads the OpenAI API key from macOS Keychain in normal use.
# This file intentionally contains no credentials.
OPENAI_API_KEY=

# Optional runtime overrides
JARVIS_MODEL=
JARVIS_BASE_URL=

# Local traces remain in data/jarvis.db. OpenAI trace content is redacted by default.
JARVIS_TRACE_MODE=full
JARVIS_OPENAI_TRACE_CONTENT=false
