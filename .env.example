# Jarvis reads the OpenAI API key from macOS Keychain in normal use.
# This file intentionally contains no credentials.
OPENAI_API_KEY=

# Optional runtime overrides
JARVIS_MODEL=
JARVIS_BASE_URL=

# Traces are exported over OTLP to a self-hosted Phoenix server on localhost.
JARVIS_TRACE_MODE=full
JARVIS_PHOENIX_PORT=6006
